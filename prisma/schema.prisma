generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Definición de enums -------------------------------------------------------------------------------------------------------------

enum Unidad {
  kg
  litros
}

enum Moneda {
  USD
  EUR
  ARS
}

enum Categoria {
  quesos
  leches
}

enum TipoToken {
  verificacion
  recuperacion
}

enum TipoMerma {
  Natural
  Tecnica
  Administrativa
  Danio
}

enum ConceptoCosto {
  insumos_basicos
  leche_cruda
  cuajo_y_fermentos
  refrigeracion
}

enum RolOrganizacion {
  ORG_OWNER
  ORG_ADMIN
  MEMBER
}

enum RolEstablecimiento {
  OWNER
  ADMIN
  EMPLOYEE
}

enum EstadoInvitacion {
  pendiente
  aceptada
  rechazada
}

enum TipoOrdenie {
  balde
  linea
  espina_de_pescado
  rotativo
  manual
  otro
}

enum VentaLeche {
  usina
  fabrica_propia
  cooperativa
  varios
}

// Definición de modelos -------------------------------------------------------------------------------------------------------------

model Usuario {
  idUsuario                   String                      @id @default(uuid())
  correo                      String                      @unique
  contrasena                  String
  nombre                      String                      @db.VarChar(50)
  verificado                  Boolean                     @default(false)
  fechaCreacion               DateTime                    @default(now())
  activo                      Boolean                     @default(true)
  tokens                      VerificarToken[]
  organizaciones              OrganizacionUsuario[]
  invitacionesOrganizacion    InvitacionOrganizacion[]
  invitacionesEstablecimiento InvitacionEstablecimiento[]
}

model Organizacion {
  idOrganizacion   String                   @id @default(uuid())
  nombre           String
  fechaCreacion    DateTime                 @default(now())
  usuarios         OrganizacionUsuario[]
  establecimientos Establecimiento[]
  invitaciones     InvitacionOrganizacion[]
  razas            Raza[]
  productos        Producto[]
}

model OrganizacionUsuario {
  idOrganizacionUsuario               String                                @id @default(uuid())
  idOrganizacion                      String
  organizacion                        Organizacion                          @relation(fields: [idOrganizacion], references: [idOrganizacion])
  idUsuario                           String
  usuario                             Usuario                               @relation(fields: [idUsuario], references: [idUsuario])
  rol                                 RolOrganizacion
  estado                              Boolean                               @default(true)
  fechaCreacion                       DateTime                              @default(now())
  establecimientoOrganizacionUsuarios Establecimiento_OrganizacionUsuario[]

  @@unique([idOrganizacion, idUsuario])
}

model Establecimiento {
  idEstablecimiento                   String                                @id @default(uuid())
  nombre                              String
  localidad                           String?
  provincia                           String?
  fechaCreacion                       DateTime                              @default(now())
  idOrganizacion                      String
  organizacion                        Organizacion                          @relation(fields: [idOrganizacion], references: [idOrganizacion])
  loteProducciones                    LoteProduccion[]
  establecimientoOrganizacionUsuarios Establecimiento_OrganizacionUsuario[]
  configuracions                      configuracion[]
  establecimientoRazas                EstablecimientoRaza[]
  invitaciones                        InvitacionEstablecimiento[]
  establecimientoProductos            EstablecimientoProducto[]
}

model Establecimiento_OrganizacionUsuario {
  idEstablecimientoOrganizacionUsuario String              @id @default(uuid())
  idEstablecimiento                    String
  establecimiento                      Establecimiento     @relation(fields: [idEstablecimiento], references: [idEstablecimiento])
  idOrganizacionUsuario                String
  organizacionUsuario                  OrganizacionUsuario @relation(fields: [idOrganizacionUsuario], references: [idOrganizacionUsuario])
  rol                                  RolEstablecimiento
  estado                               Boolean             @default(true)
  fechaCreacion                        DateTime            @default(now())

  @@unique([idEstablecimiento, idOrganizacionUsuario])
}

model configuracion {
  idConfiguracion   String          @id @default(uuid())
  idEstablecimiento String          @unique
  establecimiento   Establecimiento @relation(fields: [idEstablecimiento], references: [idEstablecimiento])
  ultimoNumeroLote  Int             @default(0)
  cantVacas         Int?
  cantOrdenies      Int?
  promLitros        Float?
  tipoOrdenie       TipoOrdenie?
  ventaLeche        VentaLeche?
  empleados         Boolean?
  cantEmpleados     Int?
  modificadoEn      DateTime?
}

model InvitacionOrganizacion {
  idInvitacion   String           @id @default(uuid())
  idOrganizacion String
  idInvitador    String
  correo         String
  codigo         String
  estado         EstadoInvitacion @default(pendiente)
  expiraEn       DateTime
  respondidaEn   DateTime?
  rol            RolOrganizacion

  organizacion Organizacion @relation(fields: [idOrganizacion], references: [idOrganizacion])
  invitador    Usuario      @relation(fields: [idInvitador], references: [idUsuario])

  creadoEn DateTime @default(now())
}

model InvitacionEstablecimiento {
  idInvitacion      String             @id @default(uuid())
  idEstablecimiento String
  idInvitador       String
  correo            String
  codigo            String
  estado            EstadoInvitacion   @default(pendiente)
  expiraEn          DateTime
  respondidaEn      DateTime?
  rol               RolEstablecimiento

  establecimiento Establecimiento @relation(fields: [idEstablecimiento], references: [idEstablecimiento])
  invitador       Usuario         @relation(fields: [idInvitador], references: [idUsuario])

  creadoEn DateTime @default(now())
}

model Producto {
  idProducto               String                    @id @default(uuid())
  nombre                   String
  nombreNormalizado        String
  esSistema                Boolean                   @default(false)
  idOrganizacion           String?
  organizacion             Organizacion?             @relation(fields: [idOrganizacion], references: [idOrganizacion])
  categoria                Categoria
  establecimientoProductos EstablecimientoProducto[]
  loteProduccions          LoteProduccion[]

  @@unique([nombreNormalizado, idOrganizacion])
}

model EstablecimientoProducto {
  id String @id @default(uuid())

  idEstablecimiento String
  idProducto        String

  establecimiento Establecimiento @relation(fields: [idEstablecimiento], references: [idEstablecimiento])
  producto        Producto        @relation(fields: [idProducto], references: [idProducto])

  @@unique([idEstablecimiento, idProducto])
}

model Raza {
  idRaza            String  @id @default(uuid())
  nombre            String
  nombreNormalizado String
  esSistema         Boolean @default(false)

  idOrganizacion String?
  organizacion   Organizacion? @relation(fields: [idOrganizacion], references: [idOrganizacion])

  establecimientos EstablecimientoRaza[]
  loteProduccions  LoteProduccion[]

  @@unique([nombreNormalizado, idOrganizacion])
}

model EstablecimientoRaza {
  id String @id @default(uuid())

  idEstablecimiento String
  idRaza            String

  establecimiento Establecimiento @relation(fields: [idEstablecimiento], references: [idEstablecimiento])
  raza            Raza            @relation(fields: [idRaza], references: [idRaza])

  @@unique([idEstablecimiento, idRaza])
}

model LoteProduccion {
  idLote            String          @id
  numeroLote        Int
  fechaProduccion   DateTime        @default(now())
  cantidad          Decimal
  unidad            Unidad
  estado            Boolean         @default(false)
  cantRazas         Int
  idRaza            String
  raza              Raza            @relation(fields: [idRaza], references: [idRaza])
  idProducto        String
  producto          Producto        @relation(fields: [idProducto], references: [idProducto])
  idEstablecimiento String
  establecimiento   Establecimiento @relation(fields: [idEstablecimiento], references: [idEstablecimiento])
  mermas            Merma[]
  costosDirectos    CostosDirecto[]

  @@unique([idEstablecimiento, numeroLote])
}

model Merma {
  idMerma       String         @id @default(uuid())
  tipo          TipoMerma
  observacion   String?
  cantidad      Decimal
  fechaCreacion DateTime       @default(now())
  idLote        String
  lote          LoteProduccion @relation(fields: [idLote], references: [idLote])
}

model CostosDirecto {
  idCostoDirecto String         @id @default(uuid())
  concepto       ConceptoCosto
  monto          Decimal        @db.Decimal(13, 2)
  observaciones  String?        @default("")
  fechaCreacion  DateTime       @default(now())
  idLote         String
  lote           LoteProduccion @relation(fields: [idLote], references: [idLote])
}

model VerificarToken {
  tokenid   String    @id @default(uuid())
  idUsuario String
  usuario   Usuario   @relation(fields: [idUsuario], references: [idUsuario])
  tipo      TipoToken
  tokenHash String
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())

  @@index([idUsuario, tipo])
}

//Modelos del back de IA -------------------------------------------------------------------------------------------------------------------------

enum NivelAlerta {
  bajo
  medio
  alto
}

model Alerta {
  id                String      @id @default(uuid())
  idEstablecimiento String
  idLote            String
  producto          String
  categoria         Categoria
  nivel             NivelAlerta
  descripcion       String      @db.Text
  creadoEn          DateTime    @default(now())
  visto             Boolean     @default(false)

  @@index([idEstablecimiento, creadoEn])
}

model PromedioCategoria {
  id                String    @id @default(uuid())
  idEstablecimiento String
  categoria         Categoria

  produccionAcumulada Float @default(0)
  mermaAcumulada      Float @default(0)
  pctMermaPromedio    Float @default(0)
  cantidadLotes       Int   @default(0)

  @@unique([idEstablecimiento, categoria])
}
